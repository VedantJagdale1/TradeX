// Template for Secrets.xcconfig.
//
// Setup:
//   1. cp Secrets.example.xcconfig Secrets.xcconfig
//   2. Paste your Groq key below (get one free at https://console.groq.com/keys)
//   3. Secrets.xcconfig is gitignored — never commit it.
//
// The value is injected into Info.plist as `GroqAPIKey` via the
// INFOPLIST_KEY_GroqAPIKey build setting, and read by GroqService.
GROQ_API_KEY =

// Optional: override the Groq model. Leave blank to use the app default.
// Groq retires models periodically; list yours at https://api.groq.com/openai/v1/models
GROQ_MODEL =
